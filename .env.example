APP_NAME="LovaTrip"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google AI Studio (Gemini). Ne jamais mettre cette clé dans le code ou dans VITE_*.
GEMINI_API_KEY=***
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

STRIPE_SECRET=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
DUFFEL_BOOKING_ENABLED=false
# Webhook Stripe dédié aux billets (optionnel : sinon STRIPE_WEBHOOK_SECRET est utilisé).
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_FLIGHT_WEBHOOK_SECRET=

# Vols — Duffel (recherche + émission). Une clé duffel_test_ émet des billets fictifs dans le bac à sable.
DUFFEL_API_KEY=
# Avec une clé live, mettre true pour émettre de vrais billets après paiement.

# Taxes et frais ajoutés au prix des billets (en %), appliqués à l'affichage ET au paiement Stripe.
FLIGHT_TAX_PERCENT=5
FLIGHT_TAX_LABEL="Frais de service"
FLIGHT_CART_TTL_MINUTES=30
FLIGHT_SUPPORT_EMAIL=
FLIGHT_SELLER_NAME="${APP_NAME}"
FLIGHT_SELLER_ADDRESS=

# Comparateur de prix optionnel (Aviasales / Travelpayouts) : offres non réservables, redirection partenaire.
TRAVELPAYOUTS_TOKEN=
# Partner ID (compte Travelpayouts → Profil) et ID du projet (source=… dans l'adresse des outils).
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_PROJECT_ID=
# true pour charger le script Travelpayouts Drive (liens affiliés automatiques) sur les pages Transports et Logements
TRAVELPAYOUTS_DRIVE=false

# Hébergements — commission ajoutée au prix de l'hébergeur (en %), distincte de celle des vols.
STAY_COMMISSION_PERCENT=5
STAY_COMMISSION_LABEL="Frais de service"
# Réservation instantanée d'hôtels (Duffel Stays) : à activer une fois l'accès ouvert par Duffel.
DUFFEL_STAYS_ENABLED=false
# Annuaire complet des hébergements (OpenStreetMap). Clé gratuite recommandée : https://www.geoapify.com
GEOAPIFY_API_KEY=
# Identifiant d'affiliation Booking.com (commission sur les liens sortants), facultatif.
BOOKING_AFFILIATE_ID=

# Réservation instantanée d'hôtels — LiteAPI (gratuit). Clé sandbox : https://www.liteapi.travel
# (inscription sans carte bancaire, menu Developers > API Keys). Vérification : php artisan stays:liteapi-check --book
LITEAPI_KEY=
LITEAPI_GUEST_NATIONALITY=FR

# Informations légales (mentions légales, CGV, confidentialité) — obligatoires pour un site professionnel.
LEGAL_COMPANY_NAME="${APP_NAME}"
LEGAL_FORM=
LEGAL_ADDRESS=
LEGAL_SIRET=
LEGAL_RCS=
LEGAL_VAT_NUMBER=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_ATOUT_FRANCE_NUMBER=
LEGAL_FINANCIAL_GUARANTEE=
LEGAL_RC_PRO_INSURANCE=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=

# # Mode de vente. false = modèle « partenaires vendeurs » (recommandé) : vols, hébergements et activités
# # se réservent chez les partenaires (affiliation), le site n'encaisse rien et n'est pas vendeur.
# # true = vente directe (panier + paiement + frais) : uniquement après immatriculation Atout France,
# # garantie financière et RC pro.
# DIRECT_BOOKING_ENABLED=false
# # Identifiants d'affiliation activités (facultatifs) : https://partner.getyourguide.com · https://partnerresources.viator.com
# GETYOURGUIDE_PARTNER_ID=
# VIATOR_PARTNER_ID=
# # Hôtels réservables sans quitter le site en mode partenaires : paiement dans le module Nuitée/LiteAPI
# # intégré à la page. Nuitée encaisse, rembourse et vous reverse LITEAPI_MARGIN % (vide = marge du compte).
# # Gardez une marge suffisante pour ne pas vendre sous le prix conseillé par l’hôtel (10 % conseillé).
# LITEAPI_EMBEDDED_CHECKOUT=false
# LITEAPI_MARGIN=10
# # Mode partenaires : recherche de vols précis via Duffel (gratuite en test ; en live, 0,005 $ par recherche sans vente).
# DUFFEL_PARTNER_SEARCH=false

# Chat d'assistance en temps réel (Laravel Reverb). Lancer le serveur : php artisan reverb:start
# Générer des valeurs aléatoires pour l'ID, la clé et le secret. En production derrière HTTPS :
# REVERB_HOST=votre-domaine, REVERB_PORT=443, REVERB_SCHEME=https (proxy vers le port 8080).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Comptes qui répondent au chat (accès à /admin/assistance), séparés par des virgules.
SUPPORT_ADMIN_EMAILS=
SUPPORT_RESPONSE_TIME="en général dans la journée"

# Back-office (/admin) : identifiants dédiés, sans lien avec les comptes du site.
# Laisser ADMIN_PASSWORD vide désactive le back-office. Choisir un mot de passe long et unique.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_AGENT_NAME="L’équipe LovaTrip"


ADMIN_USERNAME=admin
ADMIN_PASSWORD=