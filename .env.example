APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google AI Studio (Gemini). Ne jamais mettre cette clé dans le code ou dans VITE_*.
GEMINI_API_KEY=***
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

STRIPE_SECRET=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
DUFFEL_BOOKING_ENABLED=false
# Webhook Stripe dédié aux billets (optionnel : sinon STRIPE_WEBHOOK_SECRET est utilisé).
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_FLIGHT_WEBHOOK_SECRET=

# Vols — Duffel (recherche + émission). Une clé duffel_test_ émet des billets fictifs dans le bac à sable.
DUFFEL_API_KEY=
# Avec une clé live, mettre true pour émettre de vrais billets après paiement.

# Taxes et frais ajoutés au prix des billets (en %), appliqués à l'affichage ET au paiement Stripe.
FLIGHT_TAX_PERCENT=5
FLIGHT_TAX_LABEL="Taxes et frais de service"
FLIGHT_CART_TTL_MINUTES=30
FLIGHT_SUPPORT_EMAIL=
FLIGHT_SELLER_NAME="${APP_NAME}"
FLIGHT_SELLER_ADDRESS=

# Comparateur de prix optionnel (Aviasales / Travelpayouts) : offres non réservables, redirection partenaire.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
